{{>partials/site_header}}

<section class="admin-head-split">
    <div>
        <div class="eyebrow">BLOG</div>
        <h1>Publicações</h1>
        <p class="muted">Crie, revise, agende e publique os artigos exibidos em /blog.</p>
    </div>
    <div class="admin-head-actions">
        <a class="button primary" href="{{new_url}}">Novo artigo</a>
        <a class="button ghost" href="{{blog_url}}" target="_blank" rel="noopener noreferrer">Ver blog</a>
    </div>
</section>

<form class="admin-filterbar admin-blog-filter" method="get">
    <label class="admin-search-field">
        <span>Buscar</span>
        <input type="search" name="q" value="{{q}}" placeholder="Título, slug ou resumo">
    </label>
    <label>
        <span>Status</span>
        <select name="status">
            <option value="" {{#status_all}}selected{{/status_all}}>Todos</option>
            <option value="published" {{#status_published}}selected{{/status_published}}>Publicados</option>
            <option value="scheduled" {{#status_scheduled}}selected{{/status_scheduled}}>Agendados</option>
            <option value="draft" {{#status_draft}}selected{{/status_draft}}>Rascunhos</option>
        </select>
    </label>
    <div class="admin-filter-actions">
        <button class="button primary small" type="submit">Filtrar</button>
        <a class="button ghost small" href="{{admin_blog_url}}">Limpar</a>
    </div>
</form>

<div class="admin-result-line"><strong>{{total}}</strong> artigo(s)</div>

{{#has_posts}}
<section class="panel admin-blog-list">
    <div class="table-wrap">
        <table class="admin-table admin-blog-table">
            <thead>
            <tr>
                <th>Artigo</th>
                <th>Status</th>
                <th>Publicação</th>
                <th>Atualizado</th>
                <th>Ações</th>
            </tr>
            </thead>
            <tbody>
            {{#posts}}
            <tr>
                <td>
                    <div class="admin-blog-title-cell">
                        {{#has_cover}}<img src="{{cover_image_url}}" alt="">{{/has_cover}}
                        {{^has_cover}}<span class="admin-blog-no-cover">BLOG</span>{{/has_cover}}
                        <span>
                            <strong>{{title}}</strong>
                            <small>/blog/{{slug}}</small>
                            <small>{{author_name}}</small>
                        </span>
                    </div>
                </td>
                <td><span class="admin-badge {{status_class}}">{{status_label}}</span></td>
                <td>{{publication_date}}</td>
                <td>{{updated_at}}</td>
                <td>
                    <div class="inline-actions">
                        <a class="button ghost small" href="{{edit_url}}">Editar</a>
                        {{#can_view}}<a class="button ghost small" href="{{view_url}}" target="_blank" rel="noopener noreferrer">Ver</a>{{/can_view}}
                        <form method="post" action="{{form_action}}">
                            <input type="hidden" name="csrf_token" value="{{csrf_token}}">
                            <input type="hidden" name="id" value="{{id}}">
                            <input type="hidden" name="action" value="toggle">
                            <button class="button ghost small" type="submit">{{toggle_label}}</button>
                        </form>
                        <form method="post" action="{{form_action}}" onsubmit="return confirm('Excluir este artigo definitivamente?');">
                            <input type="hidden" name="csrf_token" value="{{csrf_token}}">
                            <input type="hidden" name="id" value="{{id}}">
                            <input type="hidden" name="action" value="delete">
                            <button class="button ghost small admin-danger-button" type="submit">Excluir</button>
                        </form>
                    </div>
                </td>
            </tr>
            {{/posts}}
            </tbody>
        </table>
    </div>
</section>
{{/has_posts}}

{{^has_posts}}<div class="empty">Nenhum artigo encontrado.</div>{{/has_posts}}

{{#show_pagination}}
<nav class="admin-pagination" aria-label="Paginação">
    {{#has_previous}}<a class="button ghost small" href="{{previous_url}}">← Anterior</a>{{/has_previous}}
    <span>Página {{page}} de {{total_pages}}</span>
    {{#has_next}}<a class="button ghost small" href="{{next_url}}">Próxima →</a>{{/has_next}}
</nav>
{{/show_pagination}}

{{>partials/site_footer}}

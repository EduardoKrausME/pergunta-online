{{>partials/site_header}}

<section class="form-page">
    <div class="eyebrow">RESPOSTA OFICIAL</div>
    <h1>{{title}}</h1>
    <p class="muted">{{body}}</p>
    <div class="admin-badge-row">
        <span class="admin-badge">Para {{target_name}}</span>
        <span class="status">{{status_label}}</span>
    </div>

    <div class="admin-dashboard-grid admin-recent-panel">
        <section class="panel">
            <div class="panel-head compact"><div><h2>Assumir pauta</h2></div></div>
            <p class="muted">Registra publicamente que uma conta autorizada assumiu a responsabilidade de responder.</p>
            <form method="post">
                <input type="hidden" name="csrf_token" value="{{csrf_token}}">
                <input type="hidden" name="action" value="take">
                <button class="button ghost" type="submit">Assumir pauta</button>
            </form>
        </section>

        <section class="panel">
            <div class="panel-head compact"><div><h2>Registrar resposta</h2></div></div>
            <form method="post" class="admin-stack-form">
                <input type="hidden" name="csrf_token" value="{{csrf_token}}">
                <input type="hidden" name="action" value="answer">
                <label><span>Resposta oficial</span><textarea name="answer_text" rows="10" required>{{answer_text}}</textarea></label>
                <button class="button primary" type="submit">Registrar resposta</button>
            </form>
        </section>
    </div>

    <section class="panel admin-recent-panel">
        <div class="panel-head compact">
            <div>
                <div class="eyebrow">EVIDÊNCIAS</div>
                <h2>Referências da resposta</h2>
            </div>
        </div>

        {{#has_evidence}}
        <div class="admin-simple-list">
            {{#evidence}}
            <div>
                <strong>{{title}}</strong>
                <small>{{type}} · {{created_at}}</small>
                {{#has_reference}}<span class="admin-evidence-reference">{{reference}}</span>{{/has_reference}}
                {{#has_file}}<a href="{{download_url}}">{{original_name}}</a>{{/has_file}}
            </div>
            {{/evidence}}
        </div>
        {{/has_evidence}}
        {{^has_evidence}}<div class="empty admin-empty-compact">Nenhuma evidência anexada ainda.</div>{{/has_evidence}}

        <form method="post" enctype="multipart/form-data" class="admin-stack-form admin-subsection">
            <input type="hidden" name="csrf_token" value="{{csrf_token}}">
            <input type="hidden" name="action" value="add_evidence">
            <div class="admin-inline-form">
                <label><span>Tipo</span>
                    <select name="evidence_type">
                        <option value="url">URL</option>
                        <option value="text">Texto</option>
                        <option value="document">Documento</option>
                        <option value="image">Imagem</option>
                        <option value="video">Vídeo</option>
                    </select>
                </label>
                <label><span>Título</span><input name="evidence_title" maxlength="190" required></label>
            </div>
            <label><span>URL ou texto</span><textarea name="reference_value" rows="3"></textarea></label>
            <label><span>Arquivo, quando aplicável · máximo 10 MB</span><input type="file" name="evidence_file"></label>
            <button class="button ghost small" type="submit">Adicionar evidência</button>
        </form>
    </section>

    <div class="admin-card-actions admin-recent-panel">
        <a class="button ghost" href="{{responses_url}}">← Minhas pautas</a>
        <a class="button ghost" href="{{question_url}}">Ver pergunta pública</a>
    </div>
</section>

{{>partials/site_footer}}

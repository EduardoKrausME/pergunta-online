<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f5f3ec">
    <title>{{page_title}}</title>
    <link rel="stylesheet" href="{{stylesheet_url}}">
</head>
<body{{#show_admin_bar}} class="admin-layout"{{/show_admin_bar}}>
<header class="site-header">
    <div class="wrap header-inner">
        <a class="brand" href="{{home_url}}"><span class="brand-dot"></span>{{site_name}}</a>
        <nav class="main-nav" aria-label="Navegação principal">
            <a href="{{home_url}}">Explorar</a>
            {{#logged_in}}
                <a href="{{ask_url}}">Nova pergunta</a>
                {{#user_is_respondent}}<a href="{{responses_url}}">Pautas</a>{{/user_is_respondent}}
                {{#user_is_admin}}<a href="{{responses_url}}">Pautas</a><a href="{{admin_url}}">Administração</a>{{/user_is_admin}}
                <span class="user-name">{{user_name}}</span>
                <a class="button ghost" href="{{logout_url}}">Sair</a>
            {{/logged_in}}
            {{#logged_out}}
                <a href="{{login_url}}">Entrar</a>
                {{#registration_enabled}}<a class="button primary small" href="{{register_url}}">Criar conta</a>{{/registration_enabled}}
            {{/logged_out}}
        </nav>
    </div>
</header>
{{#show_admin_bar}}
<div class="admin-bar">
    <div class="wrap">
        <strong>Administração</strong>
        <a href="{{admin_index_url}}">Resumo</a>
        <a href="{{admin_questions_url}}">Perguntas</a>
        <a href="{{admin_users_url}}">Usuários</a>
        <a href="{{admin_focuses_url}}">Focos</a>
        <a href="{{admin_categories_url}}">Categorias</a>
        <a href="{{admin_targets_url}}">Destinatários</a>
        <a href="{{admin_moderation_url}}">Moderação</a>
        <a href="{{admin_reports_url}}">Denúncias</a>
        <a href="{{admin_history_url}}">Histórico</a>
        <a href="{{admin_settings_url}}">Configurações</a>
        <a href="{{home_url}}">Ver site</a>
    </div>
</div>
{{/show_admin_bar}}
<main class="wrap page">
{{#flashes}}<div class="flash {{type}}">{{message}}</div>{{/flashes}}
